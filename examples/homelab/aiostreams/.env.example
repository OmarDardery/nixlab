# Copy locally inside the apps VM to .env, chmod 600. Never commit secrets.
# Use docker buildx imagetools inspect ghcr.io/viren070/aiostreams:latest
# and select the reviewed appropriate immutable digest for this VM architecture.
AIOSTREAMS_IMAGE=ghcr.io/viren070/aiostreams@sha256:REPLACE_WITH_REVIEWED_DIGEST
BASE_URL=https://aio.example.com
SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS
AIOSTREAMS_AUTH=admin:REPLACE_WITH_LONG_RANDOM_PASSWORD
